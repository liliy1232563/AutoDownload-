# Anime Auto Downloader — @Solurix_bots
# Copy this file to .env and fill in your own values.
# Never commit your real .env file or bot/database credentials to GitHub.

# Required: get these from Telegram / my.telegram.org
BOT_TOKEN=your_telegram_bot_token
API_ID=123456
API_HASH=your_telegram_api_hash
OWNER_ID=123456789

# Database (MongoDB connection string)
DATABASE_URL=mongodb+srv://username:password@cluster.example.mongodb.net/
DATABASE_NAME=AnimeAutoDownloader

# Hosting / health-check server (Render commonly provides PORT automatically)
PORT=10000

# Optional: Telegram channel IDs. Leave blank if not used.
LOG_CHANNEL=
# Multiple force-sub channels: comma-separated numeric IDs, e.g. -1001234567890,-1009876543210
FORCE_SUB_CHANNELS=

# Optional images: use a Telegram file_id or a publicly accessible HTTPS image URL.
# Leave blank to use text-only messages.
START_PIC=
HELP_PIC=
ABOUT_PIC=
FSUB_PIC=
PREMIUM_PIC=
DOWNLOAD_PIC=

# Appearance / logs
BOT_NAME=Anime Downloader
LOG_LEVEL=INFO
